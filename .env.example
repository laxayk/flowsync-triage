# Copy to .env and fill in. Never commit .env.
# --- LLM (default: hosted Groq free tier; set LLM_PROVIDER=none to use the keyword fallback only) ---
LLM_PROVIDER=none          # groq | ollama | openai | none
LLM_API_KEY=               # Groq/OpenAI key; not needed for ollama
LLM_MODEL=                 # optional, defaults: groq=openai/gpt-oss-20b, ollama=qwen2.5:3b, openai=gpt-4o-mini
LLM_BASE_URL=              # optional override (Ollama in Docker: http://host.docker.internal:11434/v1)

# --- Dedicated test mailbox over IMAP (never use your real inbox) ---
IMAP_ENABLED=false
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=             # Gmail app password

# --- Replies: capture = store only (default), live = send via SMTP ---
SEND_MODE=capture
SEND_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Notifications ---
SLACK_WEBHOOK_URL=

# --- Demo logins (change them if you expose the app) ---
AGENT_PASSWORD=agent123
APPROVER_PASSWORD=approver123

# --- Database ---
DB_PASSWORD=triage
